<Window x:Class="OPC2Modbus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OPC2Modbus - Protocol Converter"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="#FFE0E0E0">
            <MenuItem Header="File">
                <MenuItem Header="Save Configuration" Click="SaveConfiguration_Click"/>
                <MenuItem Header="Load Configuration" Click="LoadConfiguration_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="OPC Server">
                <MenuItem Header="Connect" Click="ConnectOPC_Click"/>
                <MenuItem Header="Disconnect" Click="DisconnectOPC_Click"/>
                <MenuItem Header="Browse Tags" Click="BrowseTags_Click"/>
            </MenuItem>
            <MenuItem Header="Modbus Server">
                <MenuItem Header="Start Server" Click="StartModbusServer_Click"/>
                <MenuItem Header="Stop Server" Click="StopModbusServer_Click"/>
            </MenuItem>
            <MenuItem Header="Language">
                <MenuItem Header="English" Click="SetLanguage_Click" Tag="en"/>
                <MenuItem Header="Chinese" Click="SetLanguage_Click" Tag="zh"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About" Click="About_Click"/>
                <MenuItem Header="License" Click="License_Click"/>
            </MenuItem>
        </Menu>
        
        <!-- Main Content -->
        <TabControl Grid.Row="1">
            <!-- OPC Server Configuration -->
            <TabItem Header="OPC Server">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Label Grid.Row="0" Grid.Column="0" Content="Server:"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cbOPCServer" Margin="5"/>
                    
                    <Label Grid.Row="1" Grid.Column="0" Content="IP Address:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtOPCIP" Margin="5" Text="localhost"/>
                    
                    <Label Grid.Row="2" Grid.Column="0" Content="Tags:"/>
                    <DataGrid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="dgOPCTags" Margin="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag Name" Binding="{Binding TagName}"/>
                            <DataGridTextColumn Header="Modbus Address" Binding="{Binding ModbusAddress}"/>
                            <DataGridTextColumn Header="Data Type" Binding="{Binding DataType}"/>
                            <DataGridCheckBoxColumn Header="Enable" Binding="{Binding Enable}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <!-- Modbus Server Configuration -->
            <TabItem Header="Modbus Server">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Label Grid.Row="0" Grid.Column="0" Content="Mode:"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cbModbusMode" Margin="5">
                        <ComboBoxItem Content="Modbus RTU" Tag="RTU"/>
                        <ComboBoxItem Content="Modbus TCP" Tag="TCP"/>
                    </ComboBox>
                    
                    <Label Grid.Row="1" Grid.Column="0" Content="Serial Port:"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cbSerialPort" Margin="5"/>
                    
                    <Label Grid.Row="2" Grid.Column="0" Content="Baud Rate:"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cbBaudRate" Margin="5">
                        <ComboBoxItem Content="9600"/>
                        <ComboBoxItem Content="19200"/>
                        <ComboBoxItem Content="38400"/>
                        <ComboBoxItem Content="57600"/>
                        <ComboBoxItem Content="115200"/>
                    </ComboBox>
                    
                    <Label Grid.Row="3" Grid.Column="0" Content="TCP Port:"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtTCPPort" Margin="5" Text="502"/>
                    
                    <Label Grid.Row="4" Grid.Column="0" Content="Server Status:"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtServerStatus" Margin="5" FontWeight="Bold"/>
                </Grid>
            </TabItem>
            
            <!-- Logs -->
            <TabItem Header="Logs">
                <TextBox Grid.Row="0" x:Name="txtLogs" Margin="10" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
            </TabItem>
        </TabControl>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#FFE0E0E0">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="txtLicenseStatus" Text="Trial Mode"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>